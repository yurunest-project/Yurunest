# ===========================================
# Railway（本番）用の環境変数テンプレート
# Railway → Variables にコピーして値を入れる
# 正式 URL は https://www.yurunest.com（末尾スラッシュなし）
# ===========================================

DATABASE_URL=
POSTGRES_URL=
PRISMA_DATABASE_URL=

NEXT_PUBLIC_APP_URL=https://www.yurunest.com
NEXT_PUBLIC_SITE_URL=https://www.yurunest.com
AUTH_URL=https://www.yurunest.com
AUTH_SECRET=
NEXTAUTH_SECRET=

# Stripe（本番キー。テスト運用中は sk_test_ / pk_test_ でも可）
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Dashboard で https://www.yurunest.com/api/stripe/webhook を追加したあとの whsec_
STRIPE_WEBHOOK_SECRET=

RESEND_API_KEY=
BOOKING_EMAIL_FROM=info@yurunest.com
ADMIN_EMAIL=

DAILY_API_KEY=
