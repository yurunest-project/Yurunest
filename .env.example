DATABASE_URL=
POSTGRES_URL=
PRISMA_DATABASE_URL=

# Stripe（Dashboard → 開発者 → APIキー）
# ローカル Webhook: stripe listen --forward-to localhost:3000/api/stripe/webhook
# 本番 Webhook: https://yurunest.com/api/stripe/webhook → STRIPE_WEBHOOK_SECRET を更新
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

RESEND_API_KEY=
DAILY_API_KEY=
NEXTAUTH_SECRET=

# --- ローカル開発 ---
# NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000
# NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000
# AUTH_URL=http://127.0.0.1:3000
#
# --- Railway 本番（docs/DEPLOY.md 参照）---
# NEXT_PUBLIC_APP_URL=https://yurunest.com
# NEXT_PUBLIC_SITE_URL=https://yurunest.com
# AUTH_URL=https://yurunest.com
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000
TICKET_UNIT_PRICE_JPY=500

# Auth.js v5（NEXTAUTH_SECRET と同じ値でOK。本番は openssl rand -base64 32 で新規生成）
AUTH_SECRET=
AUTH_URL=

# Daily.co 公開ドメイン
NEXT_PUBLIC_DAILY_DOMAIN=

# メール送信元（Resend で認証済みドメイン。例: ゆるネスト <info@yurunest.com>）
BOOKING_EMAIL_FROM=

# 開発時の Resend 送信テスト先（省略時は delivered@resend.dev）
DEV_EMAIL_PROBE_TO=

# スタッフ不在時の管理者通知先
ADMIN_EMAIL=

# ルーム作成 API 保護（任意）
DAILY_ROOM_ADMIN_SECRET=
